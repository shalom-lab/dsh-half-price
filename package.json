{
  "name": "@local/dsh-peak-price",
  "version": "1.0.0",
  "private": true,
  "description": "DeepSeek peak / idle pricing indicator for the Harness composer: one quiet chip, live price table, holiday data with sync.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "pricing",
    "peak-hours",
    "off-peak",
    "i18n"
  ],
  "license": "MIT",
  "author": "slren",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
