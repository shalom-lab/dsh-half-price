{
  "name": "dsh-half-price",
  "version": "1.0.0",
  "private": false,
  "description": "DeepSeek peak / idle pricing chip for the Harness composer: half price or full price at a glance, live prices, holiday data with sync.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "pricing",
    "half-price",
    "peak-hours",
    "off-peak",
    "i18n"
  ],
  "license": "MIT",
  "author": "shalom-lab",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shalom-lab/dsh-half-price.git"
  },
  "homepage": "https://github.com/shalom-lab/dsh-half-price#readme",
  "bugs": {
    "url": "https://github.com/shalom-lab/dsh-half-price/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
